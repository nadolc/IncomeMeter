{
  "KeyVault": {
    "VaultUri": "https://your-keyvault-name.vault.azure.net/"
  },
  "AzureAd": {
    "TenantId": "<azure-tenant-id>",
    "ClientId": "<azure-client-id>"
  },
  "DatabaseSettings": {
    "ConnectionString": "mongodb+srv://<user>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000",
    "DatabaseName": "incomemterdev"
  },
  "Development": {
    "UseKeyVault": false,
    "GoogleClientId": "<google-oauth-client-id>.apps.googleusercontent.com",
    "GoogleClientSecret": "<google-oauth-client-secret>",
    "JwtSecret": "<random-string-at-least-32-chars>",
    "MongoConnectionString": "mongodb+srv://<user>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000",
    "MongoDatabaseName": "incomemterdev",
    "OpenCageApiKey": "<opencage-api-key>",
    "OpenRouteServiceApiKey": "<openrouteservice-api-key>"
  },
  "AppSettings": {
    "FrontendBaseUrl": "http://localhost:5173",
    "ApiBaseUrl": "https://localhost:7079",
    "AllowedCorsOrigins": [
      "https://localhost:7001",
      "http://localhost:5000",
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Information"
    }
  },
  "Jwt": {
    "SecretKey": "<same-random-string-as-Development:JwtSecret>"
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "App_Data/uploads",
    "AzureBlobConnectionString": "",
    "AzureBlobContainer": "attachments"
  },
  "Ocr": {
    "Enabled": false,
    "Endpoint": "https://<your-resource>.cognitiveservices.azure.com/",
    "ApiKey": ""
  },
  "Dvla": {
    "ApiKey": ""
  },
  "Dvsa": {
    "ClientId": "",
    "ClientSecret": "",
    "Scope": "",
    "TokenUrl": "",
    "ApiKey": "",
    "BaseUrl": "https://history.mot.api.gov.uk"
  }
}
