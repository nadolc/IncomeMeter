{
  "DatabaseSettings": {
    "DatabaseName": "incomemterdev",
    "UsersCollectionName": "users",
    "RoutesCollectionName": "routes",
    "LocationsCollectionName": "locations",
    "TransactionsCollectionName": "transactions"
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "App_Data/uploads",
    "AzureBlobConnectionString": "",
    "AzureBlobContainer": "attachments",
    "MaxFileSizeMb": 20,
    "MaxFilesPerBatch": 100
  },
  "Ocr": {
    "Enabled": false,
    "Endpoint": "",
    "ApiKey": "",
    "ModelId": "prebuilt-receipt",
    "MinConfidence": 0.5
  },
  "TaxRules": {
    "MileageRateFirstBand": 0.45,
    "MileageRateSecondBand": 0.25,
    "MileageFirstBandMiles": 10000,
    "MotorcycleMileageRate": 0.24,
    "MainRateWda": 0.18,
    "SpecialRateWda": 0.06,
    "MainRateCo2Threshold": 50,
    "ZeroEmissionCarFya": 1.0,
    "AiaRate": 1.0,
    "OdometerGapWarningDays": 60,
    "OdometerBoundaryToleranceDays": 14
  },
  "GeocodingSettings": {
    "MaxDistanceKm": 50,
    "CoordinatePrecision": 6,
    "OpenCageBaseUrl": "https://api.opencagedata.com/geocode/v1/json",
    "OpenRouteServiceBaseUrl": "https://api.openrouteservice.org/v2/directions/driving-car"
  },
  "Jwt": {
    "Issuer": "IncomeMeter",
    "Audience": "IncomeMeter-API",
    "ExpirationHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DetailedErrors": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "System": "Warning",
        "MongoDB.Driver": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "%HOME%/LogFiles/incomemeter-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "fileSizeLimitBytes": 10485760
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "IncomeMeter.Api",
      "Environment": "Development"
    }
  },
  "Dvla": {
    "ApiKey": ""
  },
  "Dvsa": {
    "ClientId": "",
    "ClientSecret": "",
    "Scope": "",
    "TokenUrl": "",
    "ApiKey": "",
    "BaseUrl": "https://history.mot.api.gov.uk"
  }
}
